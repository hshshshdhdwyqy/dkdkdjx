API_ID=123456
API_HASH=your_api_hash
# آیدی عددی خودت (از @userinfobot) — فقط تو می‌تونی از باتا استفاده کنی
OWNER_ID=
# بات ۱ — مدیریت (الزامی): /start، فعالسازی با شماره + کیبورد کد، خاموش/روشن/حذف سلف (از @BotFather)
MANAGER_BOT_TOKEN=
# بات ۲ — هلپر (الزامی برای .پنل): پنل دکمه‌ای inline (از @BotFather + دستور /setinline)
HELPER_BOT_TOKEN=
# آیدی عددی گروهی که بازی‌ها (۲۱ و دوئل تاس) فقط توش کار کنن، مثل -1001234567890
# (از @userinfobot یا @getidsbot توی گروه بگیر). چندتا رو با کاما جدا کن. خالی = همه‌ی چت‌ها
GAME_CHAT_ID=
# مسیر عکس بنر خودت برای /start بات مدیریت (اختیاری)
BANNER_PATH=assets/banner.jpg
# پوشه‌ی بنرهای اختصاصی (عکس پروفایل هر کاربر وسط بنر NRT self ساخته می‌شه)
BANNER_DIR=banners
# برای دستور هوش مصنوعی (اختیاری)
ANTHROPIC_API_KEY=

# ===== حالت هاب چندکاربره (hub.py) — جدا از بات تکی بالا =====
# بات اصلیِ هاب: ثبت‌نام کاربرا، فعالسازی با شماره، نمایش موجودی/تست رایگان
HUB_BOT_TOKEN=
# آیدی عددی ادمین/ادمین‌ها (از @userinfobot)، با کاما جدا کن برای چندتا: 111,222
ADMIN_IDS=
# (اختیاری) بات هلپر مشترک برای «.پنل» همه‌ی کاربرا با هم
HUB_HELPER_BOT_TOKEN=
# هر الماس معادل چند ثانیه آنلاین‌بودنه (پیش‌فرض ۱۷۹۶ ثانیه ≈ نیم ساعت)
DIAMOND_SECONDS=1796
# طول تست رایگانِ هر کاربرِ جدید، به ثانیه (پیش‌فرض ۶ ساعت)
TRIAL_SECONDS=21600

# ===== پنل وب ادمین (hub.py) =====
# رمز پنل وب؛ خالی بذاری پنل وب خاموش می‌مونه. رمز قوی بذار!
WEB_PASSWORD=
# پیش‌فرض فقط از خود سرور (127.0.0.1) در دسترسه؛ برای بیرون: nginx/caddy + HTTPS یا SSH tunnel
WEB_HOST=127.0.0.1
WEB_PORT=8080
# پشت HTTPS بودی 1 بذار تا کوکی Secure بشه
WEB_SECURE=0
